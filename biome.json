{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "includes": [
      "**",
      "!public",
      "!next-env.d.ts",
      "!src/payload-types.ts",
      "!src/app/(payload)/admin/importMap.js",
      "!**/*.svg"
    ]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSameLine": false
    }
  },

  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useSelfClosingElements": "error",
        "useConst": "error",
        "useTemplate": "error",
        "noParameterAssign": "error",
        "useShorthandFunctionType": "error",
        "noUselessElse": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "off",
        "noDoubleEquals": "error",
        "noConsole": {
          "level": "warn",
          "options": { "allow": ["error", "warn"] }
        }
      },
      "complexity": {
        "useOptionalChain": "error",
        "noUselessFragments": "error"
      },
      "performance": {
        "noDelete": "error"
      }
    }
  },

  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },

  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": { "noUnknownAtRules": "off" }
        }
      }
    },
    {
      "includes": ["scripts/**", "src/seed.ts", "tests/**", "src/**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" }
        }
      }
    },

    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/*/**"],
                    "message": "Reaching into a feature's internals. Import a segment barrel instead: @/features/<name>/{model,server,ui}. Within a feature, use a relative import."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/views/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/*/**"],
                    "message": "Reaching into a feature's internals. Import a segment barrel instead: @/features/<name>/{model,server,ui}. Within a feature, use a relative import."
                  },
                  {
                    "group": ["@/app/**"],
                    "message": "Nothing may import from src/app. Routes are the top of the graph."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/*/**"],
                    "message": "Reaching into a feature's internals. Import a segment barrel instead: @/features/<name>/{model,server,ui}. Within a feature, use a relative import."
                  },
                  {
                    "group": ["@/views/**", "@/app/**"],
                    "message": "Features may not import views or routes. Take what you need as a prop, or move the shared piece down into a feature."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/*/**"],
                    "message": "Reaching into a feature's internals. Import a segment barrel instead: @/features/<name>/{model,server,ui}. Within a feature, use a relative import."
                  },
                  {
                    "group": ["@/features/**", "@/views/**", "@/app/**"],
                    "message": "src/shared is the kernel: it may not know about features, views or routes. Move this into the feature that needs it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/**",
        "!src/features/*/model/types.ts",
        "!src/shared/cms/**",
        "!src/payload.config.ts",
        "!src/seed.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/*/**"],
                    "message": "Reaching into a feature's internals. Import a segment barrel instead: @/features/<name>/{model,server,ui}. Within a feature, use a relative import."
                  },
                  {
                    "group": ["@/payload-types"],
                    "message": "payload-types.ts is generated. Re-export the type from your feature's model/types.ts and import it from there, so the generated file has one importer per feature."
                  }
                ]
              }
            }
          }
        }
      }
    },

    {
      "includes": [
        "src/payload.config.ts",
        "src/collections/**",
        "src/globals/**",
        "src/fields/**",
        "src/features/*/cms/**",
        "src/features/*/model/tags.ts",
        "src/features/contact/model/**",
        "src/shared/cms/collections/**",
        "src/shared/cms/fields/**",
        "src/shared/cms/revalidate.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/**"],
                    "message": "The Payload CLI loads this file through tsx, which does not resolve the `@/*` alias. Use a relative import."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
